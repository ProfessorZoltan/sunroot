      "siltSeasons": ["summer", "autumn"],
      "repairCost": 2
    },
    "lowRiver": {
      "name": "Low river",
      "description": "River wheels turn slowly; farms more than 2 tiles from water lose half their summer yield.",
      "farFromWaterDistance": 2,
      "farYieldFactor": 0.5
    },
    "storm": {
      "name": "Storms",
      "description": "Wind rises; one exposed building on a hill is disabled for the season unless it is next to woodland.",
      "disableCount": 1
    },
    "freeze": {
      "name": "Freeze",
      "description": "Solar is weak, homes need heat, wind is strong."
    }
  },
  "campBuilding": "foundersCamp",
